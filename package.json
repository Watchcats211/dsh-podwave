{
  "name": "dsh-podwave",
  "version": "0.1.0",
  "description": "DeepSeek Harness 插件：本地优先的播客播放器，播放硬盘上的音频，转写与双语字幕在路线图中。",
  "type": "module",
  "main": "./src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "podcast",
    "player"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Watchcats211/dsh-podwave.git"
  },
  "homepage": "https://github.com/Watchcats211/dsh-podwave#readme",
  "scripts": {
    "build": "node build.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "music-metadata": "^10.6.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "postcss": "^8.5.0"
  },
  "files": [
    "src",
    "dist",
    "cordis.patch.yml",
    "README.md"
  ]
}
